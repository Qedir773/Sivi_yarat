# CV Pro əsas Builder funksiyaları üçün heç bir environment variable məcburi deyil (local-first arxitektura).
# Bu fayl gələcək optional inteqrasiyalar üçün nümunədir. Real secret dəyər buraya YAZMAYIN.

# NEXT_PUBLIC_SITE_URL=https://cvpro.example.com

# Məcburi (AI funksiyaları üçün): OpenRouter API açarı. Pulsuz Gemini model
# (google/gemini-2.0-flash-exp:free) bu açar ilə işləyir. "AI ilə Gücləndir"
# və "Motivasiya Məktubu" funksiyaları bu açar olmadan işləmir.
# Pulsuz açar üçün: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free

# Köhnə: birbaşa Google Gemini API açarı (artıq istifadə olunmur).
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Məcburi: Admin panelə giriş üçün gizli açar. Server action-lar və /admin route
# bu token olmadan 403 qaytarır. Production-da `openssl rand -hex 32` ilə yaradın
# (minimum 32 simvol); local dev üçün 4+ simvol kifayətdir.
ADMIN_SECRET=

# Optional: Production saytın əsl URL-i (SEO, OG image, canonical link üçün).
NEXT_PUBLIC_SITE_URL=https://cvpro.example.com
